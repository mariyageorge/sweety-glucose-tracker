# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/sweety_db?schema=public"

# Authentication Secrets (Replace with a random 32+ character string in production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# Frontend Client URL (for CORS and credentials)
CLIENT_URL="http://localhost:5173"

# Application Calendar Timezone
APP_TIMEZONE="Asia/Kolkata"
